# ==============================================================================
# MERCORA BACKEND API (.env.example)
# ==============================================================================
# Copy this file as `.env` for local backend development.
# ==============================================================================

# Application Configuration
PORT=5001
NODE_ENV=development
APP_NAME="Mercora B2B Platform API"
APP_DESCRIPTION="Mercora Fullstack NestJS + TypeORM + Elasticsearch Engine"
APP_VERSION=1.0.0
CORS_ORIGIN=http://localhost:9000,http://127.0.0.1:9000

# Database Configuration (PostgreSQL / Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
DB_TYPE=postgres
DB_SYNCHRONIZE=false

# Swagger API Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# Authentication & JWT Configuration (MUST be set to unique 32+ char secrets in all environments)
JWT_ACCESS_SECRET=change-me-use-at-least-32-random-characters-for-access-jwt
JWT_REFRESH_SECRET=change-me-use-at-least-32-different-characters-for-refresh-jwt
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
SESSION_INACTIVITY_HOURS=168
FRONTEND_URL=http://localhost:9000

# Email & SMTP Configuration (Ethereal / Custom SMTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mercora Support <no-reply@mercora.com>"
SMTP_SECURE=false
MAIL_DEV_MODE=true

# Localization & Currency
DEFAULT_CURRENCY=INR
DEFAULT_CURRENCY_SYMBOL=₹

# External Government APIs
# Local Government Directory (LGD) - Official Portal: https://lgdirectory.gov.in/
LGD_API_BASE_URL=https://lgdirectory.gov.in
LGD_API_KEY=

# India Post Postal PIN Code API - Official Portal: https://api.postalpincode.in/
POSTAL_PINCODE_API_URL=https://api.postalpincode.in

# Indian Customs / ICEGATE / GST Portal
ICEGATE_API_BASE_URL=https://www.icegate.gov.in

# ─────────────────────────────────────────────────────────────────────────────
# S3-Compatible Object Storage (Neon Object Storage / AWS S3 / MinIO / R2)
# ─────────────────────────────────────────────────────────────────────────────
STORAGE_DRIVER=s3
STORAGE_BUCKET_NAME=assets
STORAGE_FORCE_PATH_STYLE=true
NEXT_PUBLIC_STORAGE_URL=https://your-endpoint/assets

AWS_ENDPOINT_URL_S3=https://<branch-id>.storage.<region>.aws.neon.tech
AWS_ACCESS_KEY_ID=your_neon_access_key_id
AWS_SECRET_ACCESS_KEY=your_neon_secret_access_key
AWS_REGION=us-east-2
