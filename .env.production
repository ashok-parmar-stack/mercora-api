# ==============================================================================
# MERCORA BACKEND API - PRODUCTION ENVIRONMENT (.env.production)
# ==============================================================================
PORT=6000
NODE_ENV=production
APP_NAME="Mercora B2B Platform API"
APP_DESCRIPTION="Mercora Fullstack NestJS + TypeORM + Elasticsearch Engine"
APP_VERSION=1.0.0
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# Database Configuration - Neon Serverless PostgreSQL
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:npg_6ebkdrhz4GqQ@ep-wandering-sunset-b4sg5b0f-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DB_TYPE=postgres
DB_HOST=ep-wandering-sunset-b4sg5b0f-pooler.c-6.us-east-2.aws.neon.tech
DB_PORT=5432
DB_USER=neondb_owner
DB_PASSWORD=npg_6ebkdrhz4GqQ
DB_NAME=neondb
DB_SSL=true

# ------------------------------------------------------------------------------
# Elasticsearch Configuration - Elastic Cloud
# ------------------------------------------------------------------------------
ELASTICSEARCH_NODE=https://c2775a6e42b74336a539930c26f04c00.us-central1.gcp.cloud.es.io:443
ELASTICSEARCH_INDEX=mercora_properties
ELASTICSEARCH_API_KEY=essu_U1ZoYU1rZzJSVUpHVjJSMU5FVTJOVnB4YkZRNmNsQnNkemx0U25oZmIyNHdablpIVERaMWVsSjRkdz09AAAAAJ6w9WM
# Swagger API Docs
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# Authentication & JWT Configuration
JWT_ACCESS_SECRET=mercora-jwt-access-secret-key-super-secure-production-2026
JWT_REFRESH_SECRET=mercora-jwt-refresh-secret-key-super-secure-production-2026
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
SESSION_INACTIVITY_HOURS=168
FRONTEND_URL=https://mercora-roan.vercel.app

# Email & SMTP Configuration
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mercora Support <no-reply@mercora.com>"
SMTP_SECURE=false
MAIL_DEV_MODE=false

# Localization & Currency
DEFAULT_CURRENCY=INR
DEFAULT_CURRENCY_SYMBOL=₹

# Logging Configuration
LOG_MAX_SIZE=20m
LOG_MAX_FILES=7d
LOG_ZIPPED_ARCHIVE=true

# External Government APIs
LGD_API_BASE_URL=https://lgdirectory.gov.in
LGD_API_KEY=
POSTAL_PINCODE_API_URL=https://api.postalpincode.in
ICEGATE_API_BASE_URL=https://www.icegate.gov.in

# Cloud Bucket & Media Storage (Neon / AWS S3)
STORAGE_DRIVER=s3
STORAGE_BUCKET_NAME=assets
STORAGE_FORCE_PATH_STYLE=true
NEXT_PUBLIC_STORAGE_URL=https://your-endpoint/assets
AWS_ENDPOINT_URL_S3=https://ep-wandering-sunset-b4sg5b0f.storage.us-east-2.aws.neon.tech
