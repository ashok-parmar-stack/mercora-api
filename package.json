{
  "name": "mercora-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:vercel": "npm run build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "sync:geography": "ts-node src/scripts/sync-all-geography.ts",
    "sync:subdistricts": "ts-node src/scripts/sync-all-geography.ts --only=subdistricts",
    "init:db": "node scripts/init-db.js",
    "init:db:local": "node scripts/init-db.js --env=.env",
    "init:db:dev": "node scripts/init-db.js --env=.env.development",
    "init:db:prod": "node scripts/init-db.js --env=.env.production",
    "init:db:neon": "node scripts/init-db.js --env=.env.production",
    "migrate:tables": "node scripts/migrate-tables.js",
    "migrate:tables:local": "node scripts/migrate-tables.js --env=.env",
    "migrate:tables:dev": "node scripts/migrate-tables.js --env=.env.development",
    "migrate:tables:prod": "node scripts/migrate-tables.js --env=.env.production",
    "migrate:tables:neon": "node scripts/migrate-tables.js --env=.env.production",
    "db:init:prod": "node scripts/init-db.js --env=.env.production",
    "db:init:neon": "node scripts/init-db.js --env=.env.production",
    "db:migrate:prod": "node scripts/migrate-tables.js --env=.env.production",
    "db:migrate:neon": "node scripts/migrate-tables.js --env=.env.production",
    "migration:run": "node scripts/migration-runner.js run",
    "migration:run:local": "node scripts/migration-runner.js run --env=.env",
    "migration:run:dev": "node scripts/migration-runner.js run --env=.env.development",
    "migration:run:prod": "node scripts/migration-runner.js run --env=.env.production",
    "migration:run:neon": "node scripts/migration-runner.js run --env=.env.production",
    "migration:revert": "node scripts/migration-runner.js revert",
    "migration:revert:local": "node scripts/migration-runner.js revert --env=.env",
    "migration:revert:dev": "node scripts/migration-runner.js revert --env=.env.development",
    "migration:revert:prod": "node scripts/migration-runner.js revert --env=.env.production",
    "migration:revert:neon": "node scripts/migration-runner.js revert --env=.env.production",
    "migration:pending": "node scripts/migration-runner.js pending",
    "migration:pending:local": "node scripts/migration-runner.js pending --env=.env",
    "migration:pending:dev": "node scripts/migration-runner.js pending --env=.env.development",
    "migration:pending:prod": "node scripts/migration-runner.js pending --env=.env.production",
    "migration:pending:neon": "node scripts/migration-runner.js pending --env=.env.production",
    "migration:status": "npm run migration:pending"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@elastic/elasticsearch": "^8.13.1",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/elasticsearch": "^11.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.19",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/typeorm": "^11.0.1",
    "axios": "^1.7.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "nest-winston": "^1.10.2",
    "nodemailer": "^6.9.13",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sqlite3": "^6.0.0",
    "typeorm": "^0.3.20",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^6.4.14",
    "@types/passport-jwt": "^4.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}
