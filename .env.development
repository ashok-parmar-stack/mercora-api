# ==============================================================================
# MERCORA BACKEND API - DEVELOPMENT ENVIRONMENT (.env.development)
# ==============================================================================
PORT=6000
NODE_ENV=development
APP_NAME="Mercora B2B Platform API"
APP_DESCRIPTION="Mercora Fullstack NestJS + TypeORM + Elasticsearch Engine"
APP_VERSION=1.0.0
CORS_ORIGIN=*

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://neondb_owner:npg_UEh0Ayq6zlsg@ep-noisy-waterfall-bb2qo3dr-pooler.c-15.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DB_TYPE=postgres
DB_HOST=ep-noisy-waterfall-bb2qo3dr-pooler.c-15.us-east-1.aws.neon.tech
DB_PORT=5432
DB_USER=neondb_owner
DB_PASSWORD=npg_UEh0Ayq6zlsg
DB_NAME=neondb
DB_SSL=true

# Neon API & Auth Services
NEON_REST_API_URL="https://ep-noisy-waterfall-bb2qo3dr.apirest.c-15.us-east-1.aws.neon.tech/neondb/rest/v1"
NEON_AUTH_URL="https://ep-noisy-waterfall-bb2qo3dr.neonauth.c-15.us-east-1.aws.neon.tech/neondb/auth"
NEON_JWKS_URL="https://ep-noisy-waterfall-bb2qo3dr.neonauth.c-15.us-east-1.aws.neon.tech/neondb/auth/.well-known/jwks.json"
SQLITE_PATH=./mercora.sqlite

# Elasticsearch Configuration (Disabled)
ELASTICSEARCH_ENABLED=false
ELASTICSEARCH_NODE=
ELASTICSEARCH_INDEX=mercora_properties
ELASTICSEARCH_API_KEY=

# Swagger API Docs
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# Authentication & JWT Configuration
JWT_ACCESS_SECRET=mercora-jwt-access-secret-key-super-secure-production-2026
JWT_REFRESH_SECRET=mercora-jwt-refresh-secret-key-super-secure-production-2026
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
SESSION_INACTIVITY_HOURS=168
FRONTEND_URL=http://localhost:9000

# Email & SMTP Configuration
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mercora Support <no-reply@mercora.com>"
SMTP_SECURE=false
MAIL_DEV_MODE=true

# Localization & Currency
DEFAULT_CURRENCY=INR
DEFAULT_CURRENCY_SYMBOL=₹

# Logging Configuration
LOG_MAX_SIZE=20m
LOG_MAX_FILES=7d
LOG_ZIPPED_ARCHIVE=true

# External Government APIs
LGD_API_BASE_URL=https://lgdirectory.gov.in
LGD_API_KEY=
POSTAL_PINCODE_API_URL=https://api.postalpincode.in
ICEGATE_API_BASE_URL=https://www.icegate.gov.in

# Cloud Bucket & Media Storage
STORAGE_DRIVER=local
STORAGE_BUCKET_NAME=assets
STORAGE_FORCE_PATH_STYLE=true
NEXT_PUBLIC_STORAGE_URL=/uploads
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
