# ==============================================================================
# MERCORA BACKEND API - DEVELOPMENT ENVIRONMENT (.env.development)
# ==============================================================================
PORT=6000
NODE_ENV=development
APP_NAME="Mercora B2B Platform API"
APP_DESCRIPTION="Mercora Fullstack NestJS + TypeORM + Elasticsearch Engine"
APP_VERSION=1.0.0
CORS_ORIGIN=*

# Database (PostgreSQL / Local / SQLite)
DATABASE_URL=
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_NAME=mercora_db
DB_SSL=false
SQLITE_PATH=./mercora.sqlite

# Elasticsearch Configuration
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_INDEX=mercora_properties
ELASTICSEARCH_API_KEY=

# Swagger API Docs
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# Authentication & JWT Configuration
JWT_ACCESS_SECRET=mercora-jwt-access-secret-key-super-secure-production-2026
JWT_REFRESH_SECRET=mercora-jwt-refresh-secret-key-super-secure-production-2026
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
SESSION_INACTIVITY_HOURS=168
FRONTEND_URL=http://localhost:9000

# Email & SMTP Configuration
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mercora Support <no-reply@mercora.com>"
SMTP_SECURE=false
MAIL_DEV_MODE=true

# Localization & Currency
DEFAULT_CURRENCY=INR
DEFAULT_CURRENCY_SYMBOL=₹

# Logging Configuration
LOG_MAX_SIZE=20m
LOG_MAX_FILES=7d
LOG_ZIPPED_ARCHIVE=true

# External Government APIs
LGD_API_BASE_URL=https://lgdirectory.gov.in
LGD_API_KEY=
POSTAL_PINCODE_API_URL=https://api.postalpincode.in
ICEGATE_API_BASE_URL=https://www.icegate.gov.in

# Cloud Bucket & Media Storage
STORAGE_DRIVER=local
STORAGE_BUCKET_NAME=assets
STORAGE_FORCE_PATH_STYLE=true
NEXT_PUBLIC_STORAGE_URL=/uploads
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
